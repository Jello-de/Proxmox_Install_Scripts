#!/usr/bin/env bash
set -Eeuo pipefail

STD=''

color() {
  BOLD='\033[1m'; GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
}
msg_info() { echo -e "${BOLD}${YELLOW}[INFO]${NC} $*"; }
msg_ok() { echo -e "${BOLD}${GREEN}[OK]${NC} $*"; }
msg_error() { echo -e "${BOLD}${RED}[ERR]${NC} $*"; }
catch_errors() { trap 'msg_error "Fehler in Zeile $LINENO"' ERR; }

network_check() {
  msg_info "Prüfe interne Erreichbarkeit"
  : "${INTERNAL_APT_HOST:?INTERNAL_APT_HOST fehlt}"
  ping -c1 -W2 "$INTERNAL_APT_HOST" >/dev/null
  msg_ok "Interner Host erreichbar: $INTERNAL_APT_HOST"
}

configure_apt_offline() {
  : "${INTERNAL_APT_MIRROR:?INTERNAL_APT_MIRROR fehlt}"
  : "${DEBIAN_CODENAME:?DEBIAN_CODENAME fehlt}"
  cat >/etc/apt/sources.list <<APT
# Enterprise offline mirror

deb ${INTERNAL_APT_MIRROR} ${DEBIAN_CODENAME} main contrib non-free non-free-firmware
APT
}

configure_proxy() {
  if [[ -n "${HTTP_PROXY:-}" ]]; then
    cat >/etc/apt/apt.conf.d/01proxy <<PXY
Acquire::http::Proxy "${HTTP_PROXY}";
Acquire::https::Proxy "${HTTPS_PROXY:-$HTTP_PROXY}";
PXY
    msg_ok "APT Proxy gesetzt"
  else
    rm -f /etc/apt/apt.conf.d/01proxy
    msg_info "Kein Proxy gesetzt"
  fi
}

update_os() {
  msg_info "APT Update/Upgrade"
  apt-get update
  apt-get -y dist-upgrade
  msg_ok "OS aktualisiert"
}

enable_unattended_security_updates() {
  apt-get install -y unattended-upgrades apt-listchanges
  dpkg-reconfigure -f noninteractive unattended-upgrades
  msg_ok "Security Updates aktiviert"
}

motd_ssh() {
  echo "Managed by Enterprise Proxmox Offline Template" >/etc/motd
}

customize() {
  systemctl enable ssh || true
}

cleanup_lxc() {
  apt-get autoremove -y
  apt-get clean
  rm -rf /var/lib/apt/lists/*
}
